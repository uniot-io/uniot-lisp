{
    "name": "uniot-lisp",
    "keywords": "uniot, lisp, minilisp, iot",
    "description": "A small LISP interpreter implementation in C",
    "repository": {
        "type": "git",
        "url": "https://github.com/uniot-io/uniot-lisp.git"
    },
    "version": "0.2.5",
    "license": "GPLv3",
    "build": {
        "includeDir": "src",
        "srcDir": ".",
        "srcFilter": "-<*> +<src/*>"
    },
    "frameworks": "arduino",
    "platforms": [
        "espressif8266",
        "espressif32"
    ],
    "export": {
        "exclude": [
            "emsdk",
            "build",
            ".pio",
            "repl",
            "repl-copying",
            "repl-mark-sweep",
            "repl-mark-sweep-small",
            "repl32",
            "repl32-copying",
            "repl32-mark-sweep",
            "bench-copying",
            "bench-mark-sweep"
        ]
    }
}
